GROUP github.com/kgatilin/signet/testdata/sdk TestPassing Passing feature
CASE id=one name="every step kind passes" (6 steps)
CASE id=two name="the shared background ran once" (4 steps)
GROUP github.com/kgatilin/signet/testdata/sdk TestStepFailures Step failures
CASE id=when-fails name="a failed action skips its checks and later actions" (4 steps)
CASE id=then-fails name="a failed check keeps its siblings and skips later actions" (4 steps)
CASE id=given-fails name="a failed precondition skips everything after it" (3 steps)
CASE id=skip-in-when name="a skipped action skips its checks" (2 steps)
CASE id=cleanup-fails name="a failed cleanup registered in a Given fails the scenario" (2 steps)
GROUP github.com/kgatilin/signet/testdata/sdk TestBackgroundOnceFails Broken background
CASE id=first name="runs the background" (1 step)
CASE id=second name="is skipped" (2 steps)
GROUP github.com/kgatilin/signet/testdata/sdk TestBackgroundFails Broken per-scenario background
CASE id=bad name="its background fails" (1 step)
CASE id=good name="its background passes" (1 step)
GROUP github.com/kgatilin/signet/testdata/sdk TestFailureOutput Failure output
CASE id=later-step-fails name="background fixtures log their commands and service output when a later step fails" (1 step)
CASE id=commands-in-steps name="a failed check logs its own commands, and the scenario logs those of its steps once" (3 steps)
GROUP github.com/kgatilin/signet/testdata/sdk TestStepResources Step resources
CASE id=outlive-step name="what a Given or When creates lives until the scenario ends" (5 steps)
